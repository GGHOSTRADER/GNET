---
title: GNET Bar, Candidate Routing, and MA Decision Flow
config:
  themeCSS: |
    .titleText { font-size: 30px !important; font-weight: 700 !important; }
---
flowchart TD

    TS([TradeStation - EasyLanguage])
    DLL["BarBridge.dll - C++ Win32 - SendBar()"]
    TCP_SOCK["TCP Socket - port 9009 - tcp_to_redis_connection.py"]
    BUF["Line Buffer - split on newline"]
    PARSE["parse_csv_line - bar_codec.py"]
    VAL_BAR["validate_bar - bar_contract.py"]
    VAL_SEQ["validate_sequence - bar_contract.py"]
    ENCODE["bar_to_redis_fields - bar_codec.py"]
    REDIS_CONN["get_redis_connection - redis_tool.py"]
    DOCKER["Docker Container - redis - port 6381"]
    REDIS[("Redis Stream - validated_bar")]
    DROP["Drop and Log - DecodeError or ContractError"]

    XREAD["redis_client.xread"]
    UNWRAP["parse_xread_to_bars - bar_codec.py"]
    FIELDS["bar_from_redis_fields - bar_codec.py"]
    BATCH["XReadBatch - bars list - last_ids dict"]

    TF["transformer_features.py - Redis orchestration - same Python process"]
    CANONICAL["canonical_features.py - FeatureEngine - canonical 13 MA formulas - 60-bar window"]
    REDIS_TF[("Redis Stream - features_transformer")]
    TRAINING["training_mlp - offline MA training"]
    ARTIFACTS["MA2CrossLE artifacts - model_best.pt - scaler_best.pkl - config.json"]
    MODEL_REGISTRY["model_registry directory - enabled model - threshold - device"]
    STRATEGY(["TradeStation MA strategy window - primary signal fires"])
    CANDIDATE_DLL["StrategyBridge.dll - generate GUID - SendCandidate() - shared connection"]
    CANDIDATE_TCP["candidate_tcp_server.py - port 9012 - validate"]
    REDIS_CANDIDATE[("Redis Stream - trade_candidates")]
    ROUTER["strategy_router.py - exact symbol + date + time match - select strategy model - infer"]
    REDIS_DECISION[("Redis Stream - trade_decisions")]
    SIG_SERVER["signal_tcp_server.py - port 9011 - persistent TCP server"]
    SIG_DLL["SignalBridge.dll - per-instance queues - non-blocking"]
    TS_RECV(["Matching TradeStation strategy window - approve or reject candidate"])

    TS -->|"1 - SEND on bar close"| DLL
    DLL -->|"2 - WRITE CSV bytes to TCP"| TCP_SOCK
    DOCKER -->|"hosts Redis on 127.0.0.1:6381"| REDIS
    REDIS_CONN -->|"creates client"| REDIS
    TCP_SOCK -->|"3 - READ from kernel buffer"| BUF
    BUF -->|"4 - EXTRACT one line at a time"| PARSE
    PARSE -->|"5 - CAST str to int and float"| VAL_BAR
    VAL_BAR -->|"6 - ENFORCE single bar invariants - pass"| VAL_SEQ
    VAL_BAR -->|"fail"| DROP
    VAL_SEQ -->|"7 - ENFORCE sequence invariants - pass"| ENCODE
    VAL_SEQ -->|"fail"| DROP
    ENCODE -->|"8 - ENCODE typed Bar to strings"| REDIS
    REDIS -->|"9 - XREAD payload"| XREAD
    XREAD -->|"10 - UNWRAP nested structure"| UNWRAP

    subgraph LOOP ["LOOP - for each entry in XREAD result"]
        UNWRAP -->|"one field map per entry"| FIELDS
        FIELDS -->|"typed Bar appended to list"| BATCH
        UNWRAP -->|"after all entries done"| BATCH
    end

    BATCH -->|"11 - YIELD typed Bars"| TF
    TF -->|"12 - in-process call per bar"| CANONICAL
    CANONICAL -.->|"13 - return 13 FeatureValues"| TF
    TF -->|"14 - PUSH feature record"| REDIS_TF
    TRAINING -->|"produces"| ARTIFACTS
    STRATEGY -->|"15 - primary trade candidate only"| CANDIDATE_DLL
    CANDIDATE_DLL -->|"16 - GUID candidate over shared TCP"| CANDIDATE_TCP
    CANDIDATE_TCP -->|"17 - validated candidate"| REDIS_CANDIDATE
    ARTIFACTS -->|"referenced by"| MODEL_REGISTRY
    MODEL_REGISTRY -->|"loaded once at startup"| ROUTER
    REDIS_TF -->|"18a - cache exact bar features"| ROUTER
    REDIS_CANDIDATE -->|"18b - match symbol, date, time - bar number diagnostic only"| ROUTER
    ROUTER -->|"19 - explicit approved, rejected, or error"| REDIS_DECISION
    REDIS_DECISION -->|"20 - XREAD decision"| SIG_SERVER
    SIG_SERVER -->|"21 - exact-candidate decision line"| SIG_DLL
    SIG_DLL -->|"22 - RecvDecision(instance_id)"| TS_RECV

    subgraph PIPELINES ["Feature Pipelines - read only - no re-validation"]
        TF
        CANONICAL
    end

    subgraph INGEST ["Ingestion - tcp_to_redis_connection.py"]
        BUF
        PARSE
        ENCODE
        DROP
    end

    subgraph CONTRACT ["Contract Enforcement - bar_contract.py"]
        VAL_BAR
        VAL_SEQ
    end

    subgraph INFRA ["Infrastructure"]
        REDIS_CONN
        DOCKER
    end

    subgraph INFERENCE_LAYER ["Candidate-Triggered Inference and Return"]
        ARTIFACTS
        MODEL_REGISTRY
        CANDIDATE_TCP
        REDIS_CANDIDATE
        ROUTER
        REDIS_DECISION
        SIG_SERVER
        SIG_DLL
    end

    classDef barPath fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:2px
    classDef strategyPath fill:#f3e8ff,stroke:#9333ea,color:#581c87,stroke-width:2px
    classDef sharedPath fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:2px
    class DLL,TCP_SOCK,BUF,PARSE,VAL_BAR,VAL_SEQ,ENCODE,TF,CANONICAL,REDIS_TF barPath
    class STRATEGY,CANDIDATE_DLL,CANDIDATE_TCP,REDIS_CANDIDATE,ROUTER,REDIS_DECISION,SIG_SERVER,SIG_DLL,TS_RECV strategyPath
    class TS,REDIS_CONN,DOCKER,REDIS,TRAINING,ARTIFACTS,MODEL_REGISTRY sharedPath
