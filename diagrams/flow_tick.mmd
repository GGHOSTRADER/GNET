---
title: GNET Tick Validation and Volume-Profile Flow
config:
  themeCSS: |
    .titleText { font-size: 30px !important; font-weight: 700 !important; }
---
flowchart TD

    TS([TradeStation - EasyLanguage])
    DLL["TickBridge.dll - C++ Win32 - SendTick()"]
    TCP_SOCK["TCP Socket - port 9010 - tcp_to_redis_ticks.py"]
    BUF["Line Buffer - split on newline"]
    XADD["r.xadd - raw_tick + tcp_received_ns - NO parsing - NO validation"]
    REDIS_RAW[("Redis Stream - tick_data_raw")]

    XREAD["r.xread - block=100ms - count=500 - tick_validator.py"]
    EXTRACT["parse_xread_raw_tick_records - tick_codec.py - raw line + transport metadata"]
    CAST["parse_raw_tick_line - tick_codec.py - cast str to int and float"]
    VAL_TICK["validate_tick - tick_contract.py - enforce invariants - high == low"]
    VAL_SEQ["validate_tick_sequence - tick_contract.py - enforce bar_num monotonicity"]
    ENCODE["tick_to_redis_fields - encode Tick + tcp and validator timestamps"]
    REDIS_CLEAN[("Redis Stream - tick_data_validated")]
    DROP["Drop and Log - TickDecodeError or TickContractError"]

    VP_READ["stream_ticks_from_redis - volume_profile.py - xread tick_data_validated"]
    VP_UPDATE["_update - O(1) profile update - profile[index] += volume - every tick"]
    VP_GATE{"time_s % snapshot_interval_s == interval - 1 ?"}
    VP_SNAP["_snapshot - POC + Value Area + canonical 32 features - runs on each qualifying tick"]
    REDIS_VP[("Redis Stream - features_volume_profile - maxlen 50000 - may contain multiple entries per interval")]
    PROFILER["tick_pipeline_profiler.py - exact tick join - p50 p95 p99 max per hop"]

    TS -->|"1 - SEND on every tick"| DLL
    DLL -->|"2 - WRITE CSV bytes to TCP"| TCP_SOCK
    TCP_SOCK -->|"3 - READ from kernel buffer"| BUF
    BUF -->|"4 - EXTRACT one line at a time"| XADD
    XADD -->|"5 - PUSH raw line - no processing"| REDIS_RAW

    REDIS_RAW -->|"6 - XREAD raw stream"| XREAD
    XREAD -->|"7 - UNWRAP XREAD structure"| EXTRACT
    EXTRACT -->|"8 - raw CSV line"| CAST
    CAST -->|"9 - typed Tick - pass"| VAL_TICK
    CAST -->|"fail"| DROP
    VAL_TICK -->|"10 - pass"| VAL_SEQ
    VAL_TICK -->|"fail"| DROP
    VAL_SEQ -->|"11 - pass"| ENCODE
    VAL_SEQ -->|"fail"| DROP
    ENCODE -->|"12 - PUSH clean tick"| REDIS_CLEAN

    REDIS_CLEAN -->|"13 - XREAD validated ticks"| VP_READ
    VP_READ -->|"14 - typed Tick"| VP_UPDATE
    VP_UPDATE --> VP_GATE
    VP_GATE -->|"no snapshot - continue consuming ticks"| VP_READ
    VP_GATE -->|"15 - yes, tick timestamp is in final second"| VP_SNAP
    VP_SNAP -->|"16 - PUSH POC + VA + derived features"| REDIS_VP
    REDIS_RAW -.-> PROFILER
    REDIS_CLEAN -.-> PROFILER
    REDIS_VP -.-> PROFILER

    subgraph INGEST ["Ingest - tcp_to_redis_ticks.py - drain kernel buffer only"]
        TCP_SOCK
        BUF
        XADD
    end

    subgraph VALIDATION ["Validation - tick_validator.py - separate process"]
        XREAD
        EXTRACT
        CAST
        VAL_TICK
        VAL_SEQ
        ENCODE
        DROP
    end

    subgraph VOLUME_PROFILE ["Volume Profile - volume_profile.py - update every tick, publish once at wall-clock 29.925"]
        VP_READ
        VP_UPDATE
        VP_GATE
        VP_SNAP
    end

