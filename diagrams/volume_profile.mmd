flowchart TD

    REDIS_TICK[("Redis Stream - tick_data_validated")]
    XREAD["r.xread() - block=250ms - count=200"]
    PARSE["parse_xread_to_ticks() - tick_codec.py - decode + cast only - already validated by tick_validator.py"]

    FIRST{"first tick of session?"}
    INIT["initialize_profile() - canonical_volume_profile.py - pre-allocate centered profile grid"]

    UPDATE["update_profile() - canonical_volume_profile.py - snap price and update O(1)"]
    BOUNDS{"index within grid?"}
    ADD["profile[index] += volume - single C op"]

    EXTEND_LOW["extend low - prepend zeros - max(extension - gap) ticks - min_price shifts down - extensions += 1"]
    EXTEND_HIGH["extend high - append zeros - max(extension - gap) ticks - extensions += 1"]

    GATE{"tick.time_s % snapshot_interval_s == snapshot_interval_s - 1 ?"}

    SNAPSHOT["snapshot_profile() - canonical_volume_profile.py - immutable snapshot arrays"]
    POC["find_poc() - canonical math - np.argmax"]
    VA["find_value_area() - canonical math - 70 percent coverage"]
    DERIVED["canonical feature contract - 32 VP features - classified delta - shape - nodes - velocity"]

    RESULT["VolumeProfileResult - total, Up, Down, and delta arrays - POC - Value Area - 32 scalar features"]

    REDIS_OUT[("Redis Stream - features_volume_profile - scalar fields only - may contain multiple entries per interval")]

    REDIS_TICK -->|"XREAD validated ticks"| XREAD
    XREAD --> PARSE
    PARSE -->|"typed Tick - high == low"| FIRST
    FIRST -->|"yes - new day or startup"| INIT
    INIT --> UPDATE
    FIRST -->|"no"| UPDATE
    UPDATE --> BOUNDS
    BOUNDS -->|"within grid"| ADD
    BOUNDS -->|"below floor"| EXTEND_LOW
    BOUNDS -->|"above ceiling"| EXTEND_HIGH
    EXTEND_LOW --> ADD
    EXTEND_HIGH --> ADD
    ADD --> GATE
    GATE -->|"no - wait for next tick"| XREAD
    GATE -->|"yes - each tick timestamped in final second"| SNAPSHOT
    SNAPSHOT --> POC
    SNAPSHOT --> VA
    POC --> DERIVED
    VA --> DERIVED
    DERIVED -->|"update prev_poc_price"| RESULT
    POC -->|"poc_price - poc_volume"| RESULT
    VA -->|"val - vah"| RESULT
    RESULT -->|"xadd scalar fields"| REDIS_OUT

    subgraph ADAPTER ["Adapter - stream_ticks_from_redis() inside volume_profile.py - reads tick_data_validated"]
        XREAD
        PARSE
    end

    subgraph APPLICATION ["Live application - volume_profile.py - Redis lifecycle + snapshot cadence"]
        FIRST
        INIT
        GATE
    end

    subgraph DOMAIN ["Canonical domain - canonical_volume_profile.py - shared by live and historical replay"]
        UPDATE
        BOUNDS
        ADD
        EXTEND_LOW
        EXTEND_HIGH
        SNAPSHOT
        POC
        VA
        DERIVED
    end

