title: GNET System Overview
config:
  themeCSS: |
    .titleText { font-size: 30px !important; font-weight: 700 !important; }
---
flowchart TD

    LEGEND_BAR["Blue: Bar pipeline"]
    LEGEND_TICK["Green: Tick and volume-profile pipeline"]
    LEGEND_SHARED["Gray: Shared infrastructure"]
    LEGEND_STRATEGY["Purple: Strategy candidate and decision path"]

    TS([TradeStation])
    LEGEND_BAR ~~~ LEGEND_TICK
    LEGEND_TICK ~~~ LEGEND_SHARED
    LEGEND_SHARED ~~~ LEGEND_STRATEGY
    LEGEND_STRATEGY ~~~ TS

    TS -->|"bar close"| BAR_DLL["BarBridge.dll - port 9009"]
    TS -->|"every tick"| TICK_DLL["TickBridge.dll - port 9010"]

    BAR_DLL -->|"CSV"| BAR_SERVER["tcp_to_redis_connection.py - parse - validate - encode"]
    TICK_DLL -->|"CSV"| TICK_SERVER["tcp_to_redis_ticks.py - raw passthrough only"]

    BAR_SERVER -->|"validated_bar"| REDIS[("Redis - Docker port 6381 - bar, tick, feature, candidate, and decision streams")]
    TICK_SERVER -->|"tick_data_raw"| REDIS

    REDIS -->|"tick_data_raw"| VALIDATOR["tick_validator.py - cast - validate"]
    VALIDATOR -->|"tick_data_validated"| REDIS

    REDIS -->|"validated_bar"| TF["transformer_features.py - Redis orchestration and publishing"]
    TF -->|"in-process library call"| CANONICAL["canonical_features.py - FeatureEngine - 13 MA formulas"]
    CANONICAL -.->|"13 FeatureValues returned"| TF
    REDIS -->|"tick_data_validated"| VP["volume_profile.py - Redis adapter and snapshot cadence"]
    VP -->|"in-process library call"| CANONICAL_VP["canonical_volume_profile.py - total, Up, Down state - POC - Value Area - 32 features"]
    CANONICAL_VP -.->|"VolumeProfileResult"| VP

    TF -->|"features_transformer"| REDIS
    VP -->|"features_volume_profile - qualifying final-second ticks"| REDIS

    TS -->|"only when a primary strategy proposes a trade"| STRATEGY_DLL["StrategyBridge.dll - shared port 9012"]
    STRATEGY_DLL -->|"strategy + instance + GUID + bar identity"| CANDIDATE_SERVER["candidate_tcp_server.py - validate and publish"]
    CANDIDATE_SERVER -->|"trade_candidates"| REDIS

    REDIS -->|"exact features plus durable candidate group"| ROUTER["strategy_router.py - exact bar match - model selection - inference - ACK after decision publish"]
    TRAINING["training_mlp - offline MA training"] -->|"produces"| ARTIFACTS["MA2CrossLE model artifacts - model_best.pt - scaler_best.pkl - config.json"]
    ARTIFACTS -->|"referenced by"| REGISTRY["model_registry directories - enabled - threshold - device"]
    UI["Local registry page - 127.0.0.1:9020"] -->|"validated configuration edits"| REGISTRY
    REGISTRY -->|"enabled models loaded once at startup"| ROUTER
    ROUTER -->|"trade_decisions - approved or rejected"| REDIS

    REDIS -->|"durable decision consumer group"| SIG_SERVER["signal_tcp_server.py - port 9011 - ACK after TCP delivery"]
    SIG_SERVER -->|"correlated instance decision"| SIG_DLL["SignalBridge.dll - per-instance queues"]
    SIG_DLL -->|"matching candidate decision"| TS

    classDef barPath fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:2px
    classDef tickPath fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px
    classDef sharedPath fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:2px
    classDef strategyPath fill:#f3e8ff,stroke:#9333ea,color:#581c87,stroke-width:2px
    WATCHDOG["Windows Task Scheduler - ON or OFF - watchdog restarts failed Python services"] -.-> ROUTER
    WATCHDOG -.-> TF

