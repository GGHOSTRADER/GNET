    class TICK_DLL,TICK_SERVER,VALIDATOR,VP,CANONICAL_VP tickPath
    class TS,REDIS,UI,WATCHDOG sharedPath
    class STRATEGY_DLL,CANDIDATE_SERVER,ROUTER,SIG_SERVER,SIG_DLL strategyPath
    class LEGEND_BAR barPath
    class LEGEND_TICK tickPath
