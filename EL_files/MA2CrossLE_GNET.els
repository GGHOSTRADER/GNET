{ GNET-enabled copy of TradeStation's WA-MovAvg2Line Cross LE strategy. }
{ Each chart/strategy window must use a unique InstanceId. }

[IntrabarOrderGeneration = TRUE]

using elsystem;

Inputs:
    FastPrice(Close),
    SlowPrice(Close),
    FastLength(9),
    SlowLength(18),
    StrategyId("MA2CrossLE"),
    InstanceId("MA-ES-30S-01");

Variables:
    FastAvg(0),
    SlowAvg(0),
    send_ok(0),
    recv_ok(0),
    approved(0),
    probability(0.0),
    direction(1),
    candidate_time_s(0),
    last_candidate_bar(0),
    candidate_id(""),
    decision_id(""),
    decision_status(""),
    pending_candidate(false),
    TimeSpan tod(null);

External: "C:\Users\g_med\python_new\GNET\EL_files\StrategyBridge.dll",
    int, "SendCandidate",
    Lpstr,
    Lpstr,
    Lpstr,
    int,
    int,
    int,
    int;

External: "C:\Users\g_med\python_new\GNET\EL_files\StrategyBridge.dll",
    Lpstr, "GetLastCandidateId", Lpstr;

External: "C:\Users\g_med\python_new\GNET\EL_files\SignalBridge.dll",
    int, "RecvDecision", Lpstr;

External: "C:\Users\g_med\python_new\GNET\EL_files\SignalBridge.dll",
    int, "GetDecisionApproved", Lpstr;

External: "C:\Users\g_med\python_new\GNET\EL_files\SignalBridge.dll",
    double, "GetDecisionProb", Lpstr;

External: "C:\Users\g_med\python_new\GNET\EL_files\SignalBridge.dll",
    Lpstr, "GetDecisionStatus", Lpstr;

External: "C:\Users\g_med\python_new\GNET\EL_files\SignalBridge.dll",
    Lpstr, "GetDecisionCandidateId", Lpstr;

FastAvg = AverageFC(FastPrice, FastLength);
SlowAvg = AverageFC(SlowPrice, SlowLength);

{ Create at most one candidate for a given completed bar. }
If BarStatus(1) = 2 and
   CurrentBar > 1 and
   CurrentBar <> last_candidate_bar and
   not pending_candidate and
   FastAvg crosses over SlowAvg Then Begin

    last_candidate_bar = CurrentBar;
    tod = BarDateTime.TimeOfDay;
    candidate_time_s = IntPortion(tod.TotalSeconds);

    send_ok = SendCandidate(
        StrategyId,
        InstanceId,
        Symbol,
        Date,
        candidate_time_s,
        CurrentBar,
        direction
    );

    If send_ok = 1 Then Begin
        candidate_id = GetLastCandidateId(InstanceId);
        pending_candidate = true;
        Print(Time, " GNET candidate sent: instance=", InstanceId,
              " candidate=", candidate_id);
    End
    Else
        Print(Time, " GNET candidate send failed: instance=", InstanceId);
End;

{ Non-blocking poll on every strategy calculation. IOG permits this between
  bar closes when TradeStation is configured to update on incoming ticks. }
recv_ok = RecvDecision(InstanceId);

If recv_ok = 1 Then Begin
    approved = GetDecisionApproved(InstanceId);
    probability = GetDecisionProb(InstanceId);
    decision_status = GetDecisionStatus(InstanceId);
    decision_id = GetDecisionCandidateId(InstanceId);

    If pending_candidate and decision_id = candidate_id Then Begin
        pending_candidate = false;

        If decision_status = "ok" and approved = 1 Then Begin
            Print(Time, " GNET approved: candidate=", decision_id,
                  " probability=", probability:0:6);
            Buy ("MA2CrossLE-GNET") next bar at market;
        End
        Else
            Print(Time, " GNET rejected: candidate=", decision_id,
                  " status=", decision_status,
                  " probability=", probability:0:6);
    End
    Else
        Print(Time, " GNET ignored unmatched decision: expected=", candidate_id,
              " received=", decision_id);
End
Else If recv_ok = -1 Then
    Print(Time, " GNET decision connection unavailable for ", InstanceId);

